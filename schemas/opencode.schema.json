{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Active OpenCode Configuration",
  "type": "object",
  "anyOf": [
    { "required": ["plugin"] },
    { "required": ["plugins"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "plugin": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "plugins": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "agent": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "mode": { "type": "string" },
          "prompt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "mode": { "type": "string" },
          "system": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "mcp": {
      "oneOf": [
        {
          "description": "V1 flat map of MCP server entries",
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/mcpServer" }
        },
        {
          "description": "V2 nested mcp.servers wrapper",
          "type": "object",
          "required": ["servers"],
          "properties": {
            "servers": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/mcpServer" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "lsp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "extensions"],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "extensions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "mcpServer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["local", "remote"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": { "type": "string", "minLength": 1 },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "enabled": { "type": "boolean" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "disabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "local" } }, "required": ["type"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "remote" } }, "required": ["type"] },
          "then": { "required": ["url"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
